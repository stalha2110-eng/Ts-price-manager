rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "8zvT2OITGeUj8nkaCK6sQbnmDGD2" ||
        request.auth.uid == "fWwFwc1QL6baVX9hYsSeFFFZZHe2" ||
        request.auth.uid == "oLvNJhJsTfVONWrMhtQa22bAF1g1" ||
        (request.auth.token.email != null && (
          request.auth.token.email == "stalha2110@gmail.com" ||
          request.auth.token.email == "shakirsir2122@gmail.com" ||
          request.auth.token.email == "gzone212006@gmail.com"
        ))
      );
    }

    // Public test document to allow unauthenticated backend availability checks safely
    match /test/connection {
      allow read: if true;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{allChildren=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
