# GEMINI_API_KEY: Primary key for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_SECONDARY: Optional secondary fallback key for failover on 429 quota limit.
GEMINI_API_KEY_SECONDARY="MY_SECONDARY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Optional comma-separated list of Gemini API keys for rotation pool.
GEMINI_API_KEYS="KEY_1,KEY_2,KEY_3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

